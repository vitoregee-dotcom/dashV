{
  "manifest_version": 3,
  "name": "PartsFlow no WhatsApp",
  "short_name": "PF WhatsApp",
  "version": "1.5",
  "description": "Liga o PartsFlow ao WhatsApp Web: painel do PF ao lado da conversa e envio do mapa pra vários fornecedores de uma vez.",
  "icons": { "16": "icone16.png", "48": "icone48.png", "128": "icone128.png" },
  "action": { "default_title": "PartsFlow no WhatsApp", "default_icon": { "16": "icone16.png", "48": "icone48.png" } },
  "background": { "service_worker": "fundo.js" },
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://vitoregee-dotcom.github.io/*",
    "https://*.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["whatsapp.js"],
      "css": ["whatsapp.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://vitoregee-dotcom.github.io/*",
    "https://*.vercel.app/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["ponte.js"],
      "run_at": "document_idle"
    }
  ]
}
