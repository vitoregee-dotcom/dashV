(function(){
  var dados = ccLoad();
  var lista = [];
  Object.keys(dados).forEach(function(fam){
    if(!Array.isArray(dados[fam])) return;
    dados[fam].forEach(function(it){
      var semVeic = !it.veiculos || !Array.isArray(it.veiculos) || it.veiculos.length === 0;
      if(semVeic){
        lista.push({familia: fam, codigo: it.codigo, linha: it.linha||'', substitui: it.substitui||''});
      }
    });
  });
  console.log('Total sem veiculos:', lista.length);
  copy(JSON.stringify(lista));
  console.log('✅ JSON copiado pra área de transferência! Cola no GitHub (temp/sem-aplicacao.json).');
})();
